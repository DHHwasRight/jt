{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "jt in Rust",
  "scopeName": "source.rust.jt-injection",
  "comment": "Injected into Rust files: the bodies of jt's macros get the jt rules.",
  "injectionSelector": "L:source.rust -comment -string",
  "patterns": [
    {
      "include": "#template-macro"
    },
    {
      "include": "#json-macro"
    }
  ],
  "repository": {
    "template-macro": {
      "begin": "\\b(jt)(::)(template)(!)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.namespace.rust"
        },
        "2": {
          "name": "keyword.operator.namespace.rust"
        },
        "3": {
          "name": "entity.name.function.macro.rust"
        },
        "4": {
          "name": "entity.name.function.macro.rust"
        },
        "5": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "end": "^(\\s*)(\\})",
      "endCaptures": {
        "2": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "name": "meta.embedded.jt",
      "patterns": [
        {
          "include": "source.jt"
        }
      ]
    },
    "json-macro": {
      "begin": "\\b(jt)(::)(json|write_json)(!)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.namespace.rust"
        },
        "2": {
          "name": "keyword.operator.namespace.rust"
        },
        "3": {
          "name": "entity.name.function.macro.rust"
        },
        "4": {
          "name": "entity.name.function.macro.rust"
        },
        "5": {
          "name": "punctuation.brackets.round.rust"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.round.rust"
        }
      },
      "name": "meta.embedded.jt",
      "patterns": [
        {
          "include": "source.jt#json-body"
        }
      ]
    }
  },
  "injectTo": [
    "source.rust"
  ]
}
